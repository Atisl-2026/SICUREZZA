{
  "name": "consulta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA offline per consultare un database di contenuti con l'aiuto di Gemini",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "build-db": "node scripts/build-db.mjs",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
